# Server Configuration
PORT=3000
NODE_ENV=development

# NVIDIA AI Provider API Key (Server-side only)
NVIDIA_API_KEY=

# Market Data & Exchange API Keys (Server-side placeholders for future gates)
FINNHUB_API_KEY=
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
TWELVE_DATA_API_KEY=

# Market Data Configuration Thresholds
MARKET_DATA_MAX_AGE_MS=60000
MARKET_DATA_CACHE_TTL_MS=5000
MARKET_DATA_TIMEOUT_MS=8000

# Signal Expiration Configuration (Single Source of Truth)
SIGNAL_EXPIRATION_MINUTES=240


# Centralized Signal Thresholds & Opportunity Funnel
# minimumScore: minimum score required for deterministic scoring output to be considered structurally valid (e.g. 50)
THRESHOLD_MIN_SCORE=50
# watchingThreshold: minimum score required to enter opportunity monitoring / WATCHING stage 70-74 (e.g. 70)
THRESHOLD_WATCHING_SCORE=70
# qualifiedCandidateThreshold: minimum score required to become a qualified candidate / QUALIFIED stage 75-77 (e.g. 75)
THRESHOLD_QUALIFIED_CANDIDATE_SCORE=75
# signalThreshold: minimum score required for final actionable signal generation / SIGNAL stage 78+ (e.g. 78)
THRESHOLD_SIGNAL_SCORE=78
# minimumRR: ratio (e.g. 1.8)
THRESHOLD_MIN_RR=1.8
# minimumNetRR: ratio (e.g. 1.5)
THRESHOLD_MIN_NET_RR=1.5
# minimumWinProbability: percentage 0-100 (e.g. 55)
THRESHOLD_MIN_WIN_PROB=55
# minimumStrategyAgreement: ratio 0-1 (e.g. 0.60 meaning 60%)
THRESHOLD_MIN_STRATEGY_AGREEMENT=0.60
# minimumTimeframeAlignment: ratio 0-1 (e.g. 0.60 meaning 60%)
THRESHOLD_MIN_TIMEFRAME_ALIGNMENT=0.60
# AI Confirmation Mode (REQUIRED | OPTIONAL | DISABLED)
THRESHOLD_AI_CONFIRMATION_MODE=OPTIONAL
# minimumAiConfidence: percentage 0-100 qualitative AI confidence (e.g. 55)
THRESHOLD_MIN_AI_CONFIDENCE=55
# dailySignalCap: integer count
THRESHOLD_DAILY_SIGNAL_CAP=5
# candidateLimit: integer count
THRESHOLD_CANDIDATE_LIMIT=10

# Application URL & Explicit CORS Allowed Origins
APP_URL=
ALLOWED_ORIGINS=

# Admin API Key (Server-side gate authentication)
ADMIN_API_KEY=

# Firebase Admin Service Account JSON (Server-side only, Vercel)
FIREBASE_SERVICE_ACCOUNT=

# External Cron Scheduler Auth Secret (Server-side only, Vercel)
SCANNER_CRON_SECRET=

# Web Push VAPID Keys (Server-side only, optional - auto-generated if omitted)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@tradingsignal.ai

# Android APK Download URL & App Version
NEXT_PUBLIC_ANDROID_APK_URL=
VITE_ANDROID_APK_URL=
NEXT_PUBLIC_ANDROID_APP_VERSION=1.0.0
VITE_ANDROID_APP_VERSION=1.0.0
