# ==============================================================================
# SERVER-ONLY ENVIRONMENT VARIABLES (NEVER EXPOSE TO BROWSER / REACT CODE)
# ==============================================================================

# Server Core Configuration
PORT=3000
NODE_ENV=development
APP_URL=
ALLOWED_ORIGINS=

# Administrative Authentication Credentials (Server-side gate authentication)
# Required for administrative operations, settings updates, and destructive routes.
ADMIN_API_KEY=
ADMIN_SECRET=
ADMIN_KEY=

# External Cron Scheduler Auth Secret (Server-side only)
# Used by external schedulers (cron-job.org, GitHub Actions, curl) to trigger /api/scanner/trigger.
SCANNER_CRON_SECRET=

# cron-job.org REST API Integration (Server-side only - for scheduler status & history sync)
CRONJOB_ORG_API_KEY=
CRONJOB_ORG_JOB_ID=

# NVIDIA AI Provider API Key (Server-side only)
NVIDIA_API_KEY=

# Market Data & Exchange API Keys (Server-side only)
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# Firebase Admin Service Account JSON (Server-side only)
FIREBASE_SERVICE_ACCOUNT=

# Web Push VAPID Keys (Server-side only - private key must never be exposed)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@tradingsignal.ai

# Market Data Configuration Thresholds
MARKET_DATA_MAX_AGE_MS=60000
MARKET_DATA_CACHE_TTL_MS=5000
MARKET_DATA_TIMEOUT_MS=8000

# Signal Expiration Configuration (Single Source of Truth)
SIGNAL_EXPIRATION_MINUTES=240

# Centralized Signal Thresholds & Opportunity Funnel
THRESHOLD_MIN_SCORE=70
THRESHOLD_WATCHING_SCORE=65
THRESHOLD_QUALIFIED_CANDIDATE_SCORE=68
THRESHOLD_SIGNAL_SCORE=70
THRESHOLD_MIN_RR=1.5
THRESHOLD_MIN_NET_RR=1.2
THRESHOLD_MIN_WIN_PROB=55
THRESHOLD_MIN_STRATEGY_AGREEMENT=0.60
THRESHOLD_MIN_TIMEFRAME_ALIGNMENT=0.60
THRESHOLD_AI_CONFIRMATION_MODE=OPTIONAL
THRESHOLD_MIN_AI_CONFIDENCE=55
THRESHOLD_DAILY_SIGNAL_CAP=5
THRESHOLD_CANDIDATE_LIMIT=10

# ==============================================================================
# BROWSER / CLIENT-EXPOSED PUBLIC VARIABLES (SAFE FOR FRONTEND BUNDLES)
# ==============================================================================

# Android APK Download URL & App Version (Public metadata)
VITE_ANDROID_APK_URL=
VITE_ANDROID_APP_VERSION=1.0.0
