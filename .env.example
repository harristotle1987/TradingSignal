# Server Configuration
PORT=3000
NODE_ENV=development

# NVIDIA AI Provider API Key (Server-side only)
NVIDIA_API_KEY=

# Market Data & Exchange API Keys (Server-side placeholders for future gates)
FINNHUB_API_KEY=
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
TWELVE_DATA_API_KEY=

# Market Data Configuration Thresholds
MARKET_DATA_MAX_AGE_MS=60000
MARKET_DATA_CACHE_TTL_MS=5000
MARKET_DATA_TIMEOUT_MS=8000

# Application URL
APP_URL=

# Firebase Admin Service Account JSON (Server-side only, Vercel)
FIREBASE_SERVICE_ACCOUNT=

# External Cron Scheduler Auth Secret (Server-side only, Vercel)
SCANNER_CRON_SECRET=

# Web Push VAPID Keys (Server-side only, optional - auto-generated if omitted)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@tradingsignal.ai

# Android APK Download URL & App Version
NEXT_PUBLIC_ANDROID_APK_URL=
VITE_ANDROID_APK_URL=
NEXT_PUBLIC_ANDROID_APP_VERSION=1.0.0
VITE_ANDROID_APP_VERSION=1.0.0
